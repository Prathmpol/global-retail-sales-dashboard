table People
	lineageTag: e2634d2d-e763-46f4-9c2c-8fd7198d9f6f

	column Person
		dataType: string
		lineageTag: 28d5eec1-51fa-4b20-9576-7b71db7cb504
		summarizeBy: none
		sourceColumn: Person

	column Region
		dataType: string
		lineageTag: ddc81bf1-d696-4aed-b1b6-08b2f94b38e1
		summarizeBy: none
		sourceColumn: Region

	partition People = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(Text.Trim(Text.Remove(FilePath, {"""", "#(lf)", "#(cr)"}))), null, true),
					Raw = Table.PromoteHeaders(Source{[Item="People", Kind="Sheet"]}[Data], [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Raw, {{"Person", type text}, {"Region", type text}}),
					NoBlanks = Table.SelectRows(Typed, each [Region] <> null and Text.Trim([Region]) <> ""),
					Unique = Table.Distinct(NoBlanks, {"Region"})
				in
					Unique

