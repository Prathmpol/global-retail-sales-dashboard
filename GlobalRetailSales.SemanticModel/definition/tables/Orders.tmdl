	column 'Discount Band' = SWITCH(TRUE(), Orders[Discount] = 0, "0% (None)", Orders[Discount] <= 0.2, "1-20%", Orders[Discount] <= 0.4, "21-40%", "41%+")
		dataType: string
		lineageTag: 50fe89c1-56ae-4a01-8af2-599fa672c31c
		summarizeBy: none

	partition Orders = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(Text.Trim(Text.Remove(FilePath, {"""", "#(lf)", "#(cr)"}))), null, true),
					OrdersRaw = Table.PromoteHeaders(Source{[Item="Orders", Kind="Sheet"]}[Data], [PromoteAllScalars=true]),
					ReturnsRaw = Table.Distinct(Table.PromoteHeaders(Source{[Item="Returns", Kind="Sheet"]}[Data], [PromoteAllScalars=true]), {"Order ID"}),
					Typed = Table.TransformColumnTypes(OrdersRaw, {{"Order Date", type date}, {"Ship Date", type date}, {"Sales", type number}, {"Profit", type number}, {"Quantity", Int64.Type}, {"Discount", type number}, {"Shipping Cost", type number}}),
					Merged = Table.NestedJoin(Typed, {"Order ID"}, ReturnsRaw, {"Order ID"}, "R", JoinKind.LeftOuter),
					Expanded = Table.ExpandTableColumn(Merged, "R", {"Returned"}, {"Returned"}),
					FilledReturned = Table.ReplaceValue(Expanded, null, "No", Replacer.ReplaceValue, {"Returned"}),
					AddFlag = Table.AddColumn(FilledReturned, "Returned Flag", each if [Returned] = "Yes" then 1 else 0, Int64.Type),
					AddMargin = Table.AddColumn(AddFlag, "Profit Margin %", each if [Sales] = 0 then null else [Profit] / [Sales], type number),
					AddYear = Table.AddColumn(AddMargin, "Year", each Date.Year([Order Date]), Int64.Type),
					AddMonth = Table.AddColumn(AddYear, "Month Start", each Date.StartOfMonth([Order Date]), type date),
					Final = Table.SelectColumns(AddMonth, {"Order ID", "Order Date", "Ship Date", "Ship Mode", "Customer ID", "Customer Name", "Segment", "Market", "Region", "Product ID", "Category", "Sub-Category", "Product Name", "Sales", "Quantity", "Discount", "Profit", "Shipping Cost", "Returned", "Returned Flag", "Profit Margin %", "Year", "Month Start"})
				in
					Final

