table Orders
	lineageTag: f6565a00-3abb-425f-a824-2d129c3301ae

	measure 'Total Sales' = SUM(Orders[Sales])
		formatString: $#,0
		lineageTag: 75ae6035-12e6-477c-a3cb-d9f8b4c607b0

	measure 'Total Profit' = SUM(Orders[Profit])
		formatString: $#,0
		lineageTag: e6e59aaf-4531-4ef7-87d0-4d2bc66b7868

	measure 'Total Quantity' = SUM(Orders[Quantity])
		formatString: #,0
		lineageTag: 1f083dbb-974b-4ec8-9e96-59ab4c8b4142

	measure 'Profit Margin Measure' = DIVIDE([Total Profit], [Total Sales])
		formatString: 0.0%
		lineageTag: 8e445fae-a529-41b4-9062-74d6ebb15fdb

	measure 'Total Returned Orders' = CALCULATE(DISTINCTCOUNT(Orders[Order ID]), Orders[Returned Flag] = 1)
		formatString: #,0
		lineageTag: 7b9841f3-22e5-407e-a094-fca0eb363669

	measure 'Return Rate %' = DIVIDE([Total Returned Orders], DISTINCTCOUNT(Orders[Order ID]))
		formatString: 0.0%
		lineageTag: 18f29e63-d86a-468b-bece-d246a40632ff

	measure 'Average Shipping Cost' = AVERAGE(Orders[Shipping Cost])
		formatString: $#,0.00
		lineageTag: 7956e9f7-56c7-4f58-8011-0825ddb56477

	measure 'Total Orders' = DISTINCTCOUNT(Orders[Order ID])
		formatString: #,0
		lineageTag: 06e31cdd-1b62-4764-86a0-195ad166d564

	measure 'Average Order Value' = DIVIDE([Total Sales], [Total Orders])
		formatString: $#,0.00
		lineageTag: b5373a72-f9ce-4faa-bb39-926eaaafdeb0

	/// Latest year in the current filter vs the year before it. With no year selected, the latest year in the data vs the prior year.
	measure 'Sales YoY %' =
			VAR y = MAX(Orders[Year])
			VAR cur = [Total Sales]
			VAR py = CALCULATE([Total Sales], REMOVEFILTERS(Orders[Year]), REMOVEFILTERS(Orders[Month Start]), Orders[Year] = y - 1)
			RETURN IF(NOT ISBLANK(py), DIVIDE(cur - py, py))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Growth
		lineageTag: 9f98af6f-b153-44e7-9610-e7a6ed00d670

	measure 'Total Customers' = DISTINCTCOUNT(Orders[Customer ID])
		formatString: #,0
		lineageTag: 9e6aa9f6-4d26-4fa4-9c05-8c3f7fc24cea

	measure 'Segment Sales Share %' = DIVIDE([Total Sales], CALCULATE([Total Sales], REMOVEFILTERS(Orders[Segment])))
		formatString: 0.0%
		lineageTag: ee871da7-51e7-4599-80ac-a99f8095f368

	measure 'Market Sales Share %' = DIVIDE([Total Sales], CALCULATE([Total Sales], REMOVEFILTERS(Orders[Market])))
		formatString: 0.0%
		lineageTag: ce5f125a-adb6-4eeb-a2ed-6d4c7067cfd6

	measure 'Selected Region' = SELECTEDVALUE(Orders[Region], "All Regions")
		lineageTag: ac8c046a-7d1d-411a-b86b-61d83394d54c

	measure 'Sales PY' =
			VAR y = MAX(Orders[Year])
			RETURN CALCULATE([Total Sales], REMOVEFILTERS(Orders[Year]), REMOVEFILTERS(Orders[Month Start]), Orders[Year] = y - 1)
		formatString: $#,0
		displayFolder: Growth
		lineageTag: 2965b06d-a3fd-42e4-9e6d-4714b7d409e5

	measure 'Profit YoY %' =
			VAR y = MAX(Orders[Year])
			VAR cur = [Total Profit]
			VAR py = CALCULATE([Total Profit], REMOVEFILTERS(Orders[Year]), REMOVEFILTERS(Orders[Month Start]), Orders[Year] = y - 1)
			RETURN IF(NOT ISBLANK(py), DIVIDE(cur - py, py))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Growth
		lineageTag: 6ad6c1fa-265a-4e32-97cb-57d8c0a48602

	measure 'Average Discount' = AVERAGE(Orders[Discount])
		formatString: 0.0%
		lineageTag: 8f3d0361-bc91-401e-8925-ad1a5f5b2c6a

	measure 'Loss-Making Lines %' = DIVIDE(COUNTROWS(FILTER(Orders, Orders[Profit] < 0)), COUNTROWS(Orders))
		formatString: 0.0%
		lineageTag: a8bcd7cf-7ba6-4987-b815-93d94ea3cf55

	measure 'Top Region' = MAXX(TOPN(1, VALUES(Orders[Region]), [Total Sales]), Orders[Region])
		displayFolder: Insights
		lineageTag: 9b653bba-5559-4335-8a0a-4dfec6177ebb

	measure 'Top Sub-Category' = MAXX(TOPN(1, VALUES(Orders[Sub-Category]), [Total Profit]), Orders[Sub-Category])
		displayFolder: Insights
		lineageTag: 5fb08711-8b18-481c-b7df-437efffab31d

	measure 'Top Market' = MAXX(TOPN(1, VALUES(Orders[Market]), [Total Sales]), Orders[Market])
		displayFolder: Insights
		lineageTag: aaf025d0-0c31-418b-9404-02074723c623

